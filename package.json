{
  "name": "crm-objects-tasks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test": "node --test --test-isolation=none tests/unit/request.test.mjs tests/unit/task-presentation.test.mjs",
    "test:integration": "node --test --test-isolation=none tests/integration/crm.test.mjs",
    "provision": "node scripts/provision.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "antd": "6.7.0",
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "@vitejs/plugin-react": "6.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2"
  }
}
